#if arch == "armv7"
    #include "../lib/linux_armv7.mini"
#elseif arch == "aarch64"
    #include "../lib/linux_aarch64.mini"
#elseif arch == "x86_64"
    #include "../lib/linux.mini"
#else
    #error unsupported Linux architecture
#endif

program {
    let pid: i64 = sys_getpid()
    if pid > 0 { return 42 } else { return 1 }
}
