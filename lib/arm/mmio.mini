// Cortex-M32 hardware access. The caller must validate the peripheral address,
// clock enables, access width and hardware-specific register semantics.
pub unsafe fn write32(address: usize, value: usize) {
    unsafe {
        asm {
            in r0 = address
            in r1 = value
            str
            clobber memory
        }
    }
}

pub unsafe fn read32(address: usize) -> usize {
    let result: usize = 0
    unsafe {
        asm {
            in r0 = address
            ldr
            out result = r0
            clobber memory
        }
    }
    return result
}
