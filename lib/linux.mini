// Unsafe: the caller manages descriptor ownership and lifetime.
unsafe fn sys_dup(fd: i64) -> i64 {
    let result: i64 = -1
    unsafe {
        asm {
            in rax = 32
            in rdi = fd
            syscall
            out result = rax
            clobber rcx
            clobber r11
            clobber memory
        }
    }
    return result
}

// Unsafe: the caller manages descriptor ownership and lifetime.
unsafe fn sys_fsync(fd: i64) -> i64 {
    let result: i64 = -1
    unsafe {
        asm {
            in rax = 74
            in rdi = fd
            syscall
            out result = rax
            clobber rcx
            clobber r11
            clobber memory
        }
    }
    return result
}
