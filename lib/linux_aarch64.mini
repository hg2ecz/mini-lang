// Unsafe: the caller manages descriptor ownership and lifetime.
unsafe fn sys_dup(fd: i64) -> i64 {
    let result: i64 = -1
    unsafe {
        asm {
            in x8 = 23
            in x0 = fd
            svc
            out result = x0
            clobber memory
        }
    }
    return result
}

// Unsafe: the caller manages descriptor ownership and lifetime.
unsafe fn sys_fsync(fd: i64) -> i64 {
    let result: i64 = -1
    unsafe {
        asm {
            in x8 = 82
            in x0 = fd
            svc
            out result = x0
            clobber memory
        }
    }
    return result
}
