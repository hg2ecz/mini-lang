// Unsafe: the caller manages descriptor ownership and lifetime.
unsafe fn sys_dup(fd: i64) -> i64 {
    let result: i64 = -1
    unsafe {
        asm {
            in r7 = 41
            in r0 = fd
            svc
            out result = r0
            clobber memory
        }
    }
    return result
}

// Unsafe: the caller manages descriptor ownership and lifetime.
unsafe fn sys_fsync(fd: i64) -> i64 {
    let result: i64 = -1
    unsafe {
        asm {
            in r7 = 118
            in r0 = fd
            svc
            out result = r0
            clobber memory
        }
    }
    return result
}
