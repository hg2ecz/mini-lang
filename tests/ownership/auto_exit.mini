// Exit(73) in the destructor proves that cleanup runs BEFORE return.
struct Guard { code: i64 }
fn __drop_Guard(g: Guard) {
    unsafe {
        asm {
            in rax = 60
            in rdi = g.code
            syscall
            clobber rcx
            clobber r11
            clobber memory
        }
    }
}
fn make(n: i64) -> Guard {
    unsafe { return Guard(n) }
}
program {
    let g: Guard = make(73)
    return 42
}
